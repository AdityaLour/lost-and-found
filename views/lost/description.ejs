<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    Lost Item Description
  </title>
  <link rel="stylesheet" href="/styles/variable.css">
  <link rel="stylesheet" href="/styles/description.css">

</head>

<body>
  <section class="description-card">
    <form action="/lost/description" method="post">

      <h1>
        tell us about it a bit more
      </h1>

      <div class="input-container">
        <textarea name="details" id="description" placeholder="Describe the lost item..." rows="6" required></textarea>
      </div>

      <div class="input-container">
        <input type="date" name="lostDate" id="lostDate" max="<%= new Date().toISOString().split('T')[0] %>" required>
      </div>

      <button type="submit" class="next-btn">
        Next
      </button>
    </form>
  </section>
  <script src="/scripts/background.js"></script>

</body>

</html>