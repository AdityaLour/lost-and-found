<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    Lost Item
  </title>
  <link rel="stylesheet" href="/styles/show.css">
</head>

<body>

  <main class="show-page">
    <section class="show-card">
      <div class="show-image-section">
        <img src="<%= lostItem.images[0] %>" alt="Lost Item">
      </div>

      <div class="show-content">
        <span class="show-category">
          <%= lostItem.description.category %>
        </span>

        <h1>
          Lost Item
        </h1>

        <p class="show-description">
          <%= lostItem.description.details %>
        </p>

        <div class="show-meta">
          <div class="meta-box">
            <p class="meta-title">
              Lost Date
            </p>
            <p class="meta-value">

              <%= new Date(
                lostItem.description.lostDate
              ).toDateString() %>

            </p>
          </div>
          <div class="meta-box">
            <p class="meta-title">
              Location
            </p>

            <p class="meta-value">
              <%= lostItem.location.address %>
            </p>
          </div>
        </div>
      </div>
    </section>

    <% if (
      isOwner &&
      possibleFinds.length > 0
    ) { %>

    <section class="potential-finds-section">
      <h2>
        Potential Finds
      </h2>
      <div class="potential-finds-grid">
        <% possibleFinds.forEach((entry) => {

  const item = entry.item;

%>

        <div class="potential-find-card">
          <img src="<%= item.images[0] %>" alt="Found Item">
          <div class="potential-find-content">
            <h3>
              <%= item.description.category %>
            </h3>

            <p>
              <%= item.description.details.slice(0, 100) %>...
            </p>

            <span>

              <%= new Date(
        item.description.lostDate
      ).toDateString() %>

            </span>

            <p>
              Match Score:
              <%= entry.score %>
            </p>

            <p>

              Found At:

              <%= item.location.address %>

            </p>

            <p>

              Distance:

              <%= (
    item.distance / 1000
  ).toFixed(1) %>

              km away

            </p>

          </div>

        </div>

        <% }) %>

      </div>
    </section>

    <% } %>

  </main>

</body>

</html>