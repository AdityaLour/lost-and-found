<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Images</title>

  <link rel="stylesheet" href="/styles/variable.css">
  <link rel="stylesheet" href="/styles/image.css">

  <script src="/scripts/image.js" defer></script>
</head>

<body>

  <main class="location-page">
    <section class="image-card">

      <form action="/lost/image" method="post" enctype="multipart/form-data">

        <h1>Can we see it...?</h1>

        <div class="input-container">
          <input type="file" name="images" id="images" accept="image/*" multiple required>

          <div id="preview-container"></div>
        </div>

        <p id="upload-message">
          Minimum 1 image • Maximum 3 images • 10MB each
        </p>

        <div class="btn-container">
          <button type="submit" class="next-btn btn">
            Next
          </button>
          <div class="shadow-div"></div>
        </div>

      </form>

    </section>
  </main>

  <script src="/scripts/background.js"></script>

</body>

</html>