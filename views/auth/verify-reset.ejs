<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    Verify Reset OTP
  </title>
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/auth.css">
</head>

<body>

  <div class="card">
    <p class="auth-title">
      Verify Reset OTP
    </p>

    <% if (successMessage) { %>
    <div class="message success-message">
      <%= successMessage %>
    </div>
    <% } %>
    <% if (errorMessage) { %>
    <div class="message error-message">
      <%= errorMessage %>
    </div>
    <% } %>

    <form action="/auth/verify-reset" method="post" class="auth-form">
      <input type="hidden" name="email" value="<%= email %>">

      <div class="form-group">
        <label for="otp">
          OTP
        </label>
        <input type="text" placeholder="Enter OTP" class="form-input" required id="otp" name="otp">
      </div>

      <button type="submit" class="button">
        Verify OTP
      </button>
    </form>
  </div>
</body>

</html>