<div id="messageBox" class="auth-message"></div>
<form class="auth-form" id="signupForm">

  <div class="form-group">
    <label for="username">
      Name
    </label>

    <input type="text" id="username" name="username" class="form-input" placeholder="Enter your name" required>
  </div>

  <div class="form-group">
    <label for="phoneNumber">
      Mobile Number
    </label>

    <input type="tel" id="phoneNumber" name="phoneNumber" class="form-input" placeholder="Enter your mobile number" required>
  </div>

  <div id="recaptcha-container"></div>

  <div id="otpSection" style="display:none;">
    <label for="otp">
      OTP
    </label>

    <input type="text" id="otp" maxlength="6" placeholder="Enter OTP">

    <button type="button" id="verifyOtpBtn">
      Verify OTP
    </button>
  </div>

  <button type="submit" class="button">
    Send OTP
  </button>

  <p class="auth-switch">
    Already have an account?
    <a href="/auth/login">
      Login
    </a>
  </p>
  <script type="module" src="/scripts/firebase-auth.js"></script>
</form>