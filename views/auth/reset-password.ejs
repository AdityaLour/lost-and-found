<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    Reset Password
  </title>

  <link rel="stylesheet" href="/styles/index.css">

  <link rel="stylesheet" href="/styles/auth.css">

</head>

<body>

  <div class="card">

    <p class="auth-title">
      Reset Password
    </p>

    <% if (successMessage) { %>

    <div class="message success-message">
      <%= successMessage %>
    </div>

    <% } %>

    <% if (errorMessage) { %>

    <div class="message error-message">
      <%= errorMessage %>
    </div>

    <% } %>

    <form action="/auth/reset-password" method="post" class="auth-form">

      <input type="hidden" name="email" value="<%= email %>">

      <div class="form-group">

        <label for="password">
          New Password
        </label>

        <input type="password" placeholder="Enter new password" class="form-input" required id="password" name="password">

      </div>

      <div class="form-group">

        <label for="confirmPassword">
          Confirm Password
        </label>

        <input type="password" placeholder="Confirm new password" class="form-input" required id="confirmPassword" name="confirmPassword">

      </div>

      <button type="submit" class="button">
        Reset Password
      </button>

    </form>

  </div>

</body>

</html>