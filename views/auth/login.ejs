<div id="messageBox" class="auth-message"></div>

<form class="auth-form" id="loginForm">

  <div class="form-group">
    <label for="phoneNumber">Mobile Number</label>
    <input type="tel" id="phoneNumber" class="form-input" placeholder="Mobile Number" required>
  </div>

  <div id="recaptcha-container"></div>

  <div id="otpSection" style="display:none;">
    <div class="otp-row">
      <input type="text" id="otp" maxlength="6" placeholder="Enter OTP">

      <div class="btn-container">
        <button type="button" id="verifyOtpBtn" class="button">Verify OTP</button>
        <div class="shadow-div"></div>
      </div>
    </div>
  </div>

  <div class="btn-container">
    <button type="submit" class="button btn">Send OTP</button>
    <div class="shadow-div"></div>
  </div>

  <p class="auth-switch">
    Already have an account?
    <a href="/auth/getstarted?form=signup">SignUp</a>
  </p>
</form>
<script type="module" src="/scripts/firebase-auth.js"></script>