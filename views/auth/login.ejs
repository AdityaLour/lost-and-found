<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
</head>

<body>
  <form action="/auth/login" method="post" class="auth-form">
    <div class="form-group" id="email-group">
      <label for="email">Email</label>
      <input type="text" placeholder="Enter your email address" class="form-input" required id="email" name="email">
    </div>

    <div class="form-group" id="password-group">
      <label for="password">Password</label>
      <input type="password" placeholder="Enter your password" class="form-input" required id="password" name="password">
    </div>

    <button type="submit" class="button">
      Login
    </button>

    <div class="auth-divider">
      <span>OR</span>
    </div>

    <a href="/auth/google" class="google-btn">
      <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google">
      Continue with Google
    </a>
  </form>
</body>

</html>