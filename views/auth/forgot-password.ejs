<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    Forgot Password
  </title>
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/auth.css">
</head>

<body>
  <div class="card">
    <p class="auth-title">
      Forgot Password
    </p>

    <% if (successMessage) { %>
    <div class="message success-message">
      <%= successMessage %>
    </div>
    <% } %>
    <% if (errorMessage) { %>
    <div class="message error-message">
      <%= errorMessage %>
    </div>
    <% } %>

    <form action="/auth/forgot-password" method="post" class="auth-form">
      <div class="form-group">
        <label for="email">
          Email
        </label>
        <input type="text" placeholder="Enter your email" class="form-input" required id="email" name="email">
      </div>

      <button type="submit" class="button">
        Send OTP
      </button>

    </form>
  </div>
</body>

</html>