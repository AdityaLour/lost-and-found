<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Get Started</title>
  <link rel="icon" type="image/png" href="/Favicon.png">
  <link rel="stylesheet" href="/styles/auth.css">
  <link rel="stylesheet" href="/styles/variable.css">
</head>

<body>
  <%- include("../partials/header") %>
  <div class="card">
    <p class="auth-title"><%= title  || "Create a new account"%></p>

    <% if (successMessage) { %>
    <div class="message success-message">
      <%= successMessage %>
    </div>
    <% } %>
    <% if (errorMessage) { %>
    <div class="message error-message">
      <%= errorMessage %>
    </div>

    <% } %>
    <div class="auth-toggle">
      <a href="/auth/getstarted?form=signup" class="<%= activeForm === 'signup' ? 'active' : '' %>">Sign up</a>
      <a href="/auth/getstarted?form=login" class="<%= activeForm === 'login' ? 'active' : '' %>">Log in</a>
    </div>

    <div class="form-area">
      <% if (activeForm === "signup"){ %>
      <%- include("signup") %>
      <% } else if(activeForm === "login"){ %>
      <%- include("login") %>
      <% } %>
    </div>
  </div>
  <script src="/scripts/background.js"></script>
</body>

</html>