<section class="category-card">

  <form action="/lost/category" method="post">

    <h1>What did you find?</h1>

    <div class="category-grid">

      <label class="category-option">
        <input type="checkbox" name="category" value="Wallet">
        <span>Wallet</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Phone">
        <span>Phone</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Keys">
        <span>Keys</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Bag">
        <span>Bag</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Laptop">
        <span>Laptop</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Watch">
        <span>Watch</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Documents">
        <span>Documents</span>
      </label>

      <label class="category-option">
        <input type="checkbox" name="category" value="Other">
        <span>Other</span>
      </label>

    </div>

    <div class="btn-container">
      <button type="submit" class="next-btn btn">
        Next
      </button>
      <div class="shadow-div"></div>
    </div>
  </form>
</section>