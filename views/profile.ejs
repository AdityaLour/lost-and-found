<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Profile</title>

  <link rel="stylesheet" href="/styles/profile.css">
  <link rel="stylesheet" href="/styles/variable.css">
</head>

<body>

  <%- include("./partials/header") %>

  <main class="profile-page">

    <section class="profile-card">

      <div class="profile-info">

        <div class="profile-pfp">
          <img src="/assets/animations/male-user-shadow-svgrepo-com.svg" alt="Profile">
        </div>

        <div class="profile-details">
          <h2><%= user.username %></h2>
          <p><%= user.phoneNumber %></p>
        </div>

      </div>

      <div class="profile-tabs">

        <button class="tab active" data-tab="lost">
          Lost
        </button>

        <button class="tab" data-tab="found">
          Found
        </button>

      </div>

      <!-- LOST ITEMS -->

      <div class="items-container active" id="lost-container">

        <% if (lostItems.length === 0) { %>

        <div class="empty-state">
          <h3>No Lost Items</h3>
          <p>You haven't reported any lost items yet.</p>
        </div>

        <% } else { %>

        <div class="items-grid">

          <% lostItems.forEach(item => { %>

          <div class="card-container">

            <a href="/lost/items/<%= item._id %>" class="item-card">

              <img src="<%= item.images[0] %>" alt="Lost Item">

              <div class="item-content">

                <h3>
                  <%= item.description.category %>
                </h3>

                <p>
                  <%= item.description.details.substring(0, 120) %>...
                </p>

                <span>
                  <%= new Date(item.description.lostDate).toDateString() %>
                </span>

              </div>

            </a>

            <div class="shadow-div"></div>

          </div>

          <% }) %>

        </div>

        <% } %>

      </div>

      <!-- FOUND ITEMS -->

      <div class="items-container" id="found-container">

        <% if (foundItems.length === 0) { %>

        <div class="empty-state">
          <h3>No Found Items</h3>
          <p>You haven't reported any found items yet.</p>
        </div>

        <% } else { %>

        <div class="items-grid">

          <% foundItems.forEach(item => { %>

          <div class="card-container">

            <a href="/found/items/<%= item._id %>" class="item-card">

              <img src="<%= item.images[0] %>" alt="Found Item">

              <div class="item-content">

                <h3>
                  <%= item.description.category %>
                </h3>

                <p>
                  <%= item.description.details.substring(0, 120) %>...
                </p>

                <span>
                  <%= new Date(item.description.foundDate).toDateString() %>
                </span>

              </div>

            </a>

            <div class="shadow-div"></div>

          </div>

          <% }) %>

        </div>

        <% } %>

      </div>

    </section>

  </main>

  <script>
    const tabs = document.querySelectorAll(".tab");

    const lostContainer =
      document.getElementById("lost-container");

    const foundContainer =
      document.getElementById("found-container");

    tabs.forEach((tab) => {

      tab.addEventListener("click", () => {

        tabs.forEach((btn) =>
          btn.classList.remove("active")
        );

        tab.classList.add("active");

        if (tab.dataset.tab === "lost") {

          lostContainer.classList.add("active");
          foundContainer.classList.remove("active");

        } else {

          foundContainer.classList.add("active");
          lostContainer.classList.remove("active");

        }

      });

    });
  </script>

  <script src="/scripts/background.js"></script>

</body>

</html>