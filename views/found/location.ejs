<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Choose Location</title>

  <link rel="stylesheet" href="/styles/location.css">
  <link rel="stylesheet" href="/styles/variable.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
</head>

<body>
  <section class="location-card">
    <form action="/found/location" method="post">

      <h1>Where did you Find it?</h1>

      <button id="current-location-btn" type="button">
        Use Current Location
      </button>

      <div class="divider">
        OR
      </div>

      <div id="map"></div>

      <div class="input-container">
        <input type="text" id="location-input" placeholder="Search location manually" autocomplete="off">

        <input type="hidden" name="address" id="address">
        <input type="hidden" name="latitude" id="latitude">
        <input type="hidden" name="longitude" id="longitude">
        <input type="hidden" name="source" id="source">

        <div id="suggestions"></div>
      </div>

      <p id="location-message"></p>

      <div class="btn-container">
        <button type="submit" class="next-btn btn">
          Next
        </button>
        <div class="shadow-div"></div>
      </div>
    </form>
  </section>

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script src="/scripts/location.js"></script>
  <script src="/scripts/background.js"></script>

</body>

</html>