<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    Found Items
  </title>
  <link rel="stylesheet" href="/styles/found-index.css">
  <link rel="stylesheet" href="/styles/variable.css">
</head>

<body>
  <main class="found-items-page">
    <%- include("../partials/header") %>
    <h1>
      Found Items
    </h1>

    <a href="/found/location" class="add-item-btn">
      <span style="display:block; line-height:1; transform: translateY(-1px);">+</span>
    </a>

    <section class="found-items-grid">
      <% foundItems.forEach((item) => { %>
      <div class="card-container">
        <a href="/found/items/<%= item._id %>" class="found-item-card">
          <img src="<%= item.images[0] %>" alt="Found Item">
          <div class="found-item-content">

            <span class="category">
              <%= item.description.category %>
            </span>

            <p>
              <%= item.description.details.slice(0, 20) %>...
            </p>

            <span class="date">
              <%= new Date(item.description.lostDate).toDateString() %>
            </span>

          </div>
        </a>
        <div class="shadow-div"></div>
      </div>

      <% }) %>

    </section>
  </main>
  <script src="/scripts/background.js"></script>
</body>

</html>