<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    Lost Item Description
  </title>
  <link rel="stylesheet" href="/styles/location.css">

</head>

<body>

  <main class="location-page">
    <section class="location-card">
      <form action="/found/description" method="post">

        <h1>
          tell us about it a bit more
        </h1>


        <div class="input-container">
          <textarea name="details" id="description" placeholder="Describe the lost item..." rows="6" required></textarea>
        </div>

        <div class="input-container">
          <input type="date" name="lostDate" id="lostDate" required>
        </div>

        <button type="submit" class="next-btn">
          Next
        </button>
      </form>
    </section>
  </main>
</body>

</html>